from selenium import webdriver
from selenium.webdriver.common.by import By
import time

driver = webdriver.Chrome()
driver.get("https://www.linkedin.com/login")

driver.find_element(By.ID, "username").send_keys("vedantpatel4951@gmail.com")
driver.find_element(By.ID, "password").send_keys("Vedant@03")
driver.find_element(By.XPATH, "//button[@type='submit']").click()
time.sleep(8)

page_url = "https://www.linkedin.com/company/techify-solutions-pvt-ltd/posts/?feedView=all"
driver.get(page_url)
time.sleep(5)

# ---------- SCROLL TWICE ----------
print("🔽 Scrolling 1st time...")
driver.execute_script("window.scrollBy(0, 1200);")
time.sleep(3)

print("🔽 Scrolling 2nd time...")
driver.execute_script("window.scrollBy(0, 1200);")
time.sleep(3)

print("🔍 Finding ALL unliked Like buttons after 2 scrolls...")

# ---------- FETCH ALL NOT-LIKED LIKE BUTTONS ----------
like_buttons = driver.find_elements(
    By.XPATH,
    "//button[contains(@aria-label,'Like') and not(contains(@class,'react-button--active'))]"
)

print(f"➡️ Total Like buttons found: {len(like_buttons)}")

# ---------- CLICK EACH LIKE BUTTON ----------
for idx, btn in enumerate(like_buttons, start=1):
    try:
        # bring into view
        driver.execute_script("arguments[0].scrollIntoView({block:'center'});", btn)
        time.sleep(1)

        # JS CLICK (works 100% always)
        driver.execute_script("arguments[0].click();", btn)

        print(f"❤️ Liked post {idx}")

    except Exception as e:
        print(f"❌ Could not like post {idx}: {e}")

    time.sleep(2)  # delay for safety

print("\n🎉 Done! All posts from 2 scrolls are liked.")
