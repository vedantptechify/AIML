      "parameters": {
        "jsCode": "const data = $input.all()[0];\nlet xml = '';\n\nif (data.body) {\n  xml = typeof data.body === 'string' ? data.body : JSON.stringify(data.body);\n} else if (typeof data === 'string') {\n  xml = data;\n} else {\n  xml = JSON.stringify(data);\n}\n\nif (!xml || xml.length === 0) {\n  return { headlines: [] };\n}\n\nconst headlines = [];\n\n// Extract title elements from RSS\nconst titleRegex = /<title[^>]*>([^<]+)<\\/title>/gi;\nlet match;\nlet count = 0;\n\nwhile ((match = titleRegex.exec(xml)) !== null && count < 20) {\n  const title = match[1]?.trim();\n\n  // Skip the main feed title (first one) and filter empty titles\n  if (title && title.length > 5 && title !== 'TechCrunch') {\n    if (!headlines.includes(title)) {\n      headlines.push(title);\n      count++;\n    }\n  }\n}\n\nreturn { headlines };\n"
      },
