        "jsonOutput": "=\n\n{\n\"products\": \n[\n{\n\"name\": \n\"AI Card vault\",\n\"description\": \n\"AI CardVault is an AI-powered business card scanning and lead management app designed for corporate networking. It instantly digitizes physical cards, auto-organizes contact details, and syncs seamlessly with CRMs like Salesforce, HubSpot, and Zoho. With offline functionality, multilingual support, and secure cloud storage, it ensures teams capture every lead without manual entry or errors. The platform stands out with advanced AI/OCR accuracy, dual web + mobile portals, batch scanning, custom annotations, and enterprise-grade security—helping businesses maximize event ROI, streamline follow-ups, and boost overall sales productivity.\",\n\"theme\": \n\"orange color solutions company name techify solutions\"\n},\n{\n\"name\": \n\"Bizio\",\n\"description\": \n\"Bizio is the ultimate all-in-one platform built to empower service-based companies by seamlessly connecting every stage of their business \",\n\"theme\": \n\"blue color software based product.\"\n}\n],\"Date\":\"{{ $json.Date }}\",\"Event\":\"{{ $json.Event }}\"\n}\n\n",
